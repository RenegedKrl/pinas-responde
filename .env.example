# URL pública do app (sem barra no final). Ex: https://pinas-responde.vercel.app
APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App da Meta (Instagram > API setup with Instagram login)
IG_APP_ID=
IG_APP_SECRET=
# Texto qualquer, o mesmo que você colar no campo "Verify token" do webhook
WEBHOOK_VERIFY_TOKEN=

# Chave para criptografar tokens (32+ caracteres aleatórios)
TOKEN_ENC_KEY=

# Protege o cron (a Vercel envia automaticamente se definido)
CRON_SECRET=

# Upstash QStash (opcional: atrasos entre mensagens). Sem ele, espera curta inline.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 1 depois que o app passar na auditoria (antes disso posta como privado)
TIKTOK_PUBLIC=
